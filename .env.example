# ---------------------------------------------------------------------------
# GOV3RNE — variáveis de ambiente
#
# O jogo funciona SEM NENHUMA variável configurada: o interpretador local roda
# no navegador e a partida é completa. Tudo abaixo é opcional.
# ---------------------------------------------------------------------------

# Interpretação de propostas por IA (opcional).
#
# Se AI_API_KEY estiver preenchida, a Serverless Function em /api/interpret
# passa a interpretar o texto do presidente com um modelo de linguagem. A chave
# fica no servidor da Vercel e NUNCA chega ao navegador — por isso ela não tem
# o prefixo VITE_.
#
# Sem chave, o jogo usa o interpretador local e nada quebra.
#
# Provider: "openai" | "openrouter" | "anthropic"
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS=1600

# Na Vercel: Project Settings > Environment Variables.
